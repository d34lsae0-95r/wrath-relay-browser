{
  "name": "wrath-relay-browser",
  "version": "2.0.0",
  "description": "Wrath Relay Browser — private browser + opt-in relay node",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "gg.wrath.relay",
    "productName": "Wrath",
    "icon": "icon.ico",
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "extraResources": [{ "from": "../wrath/tor-sidecar", "to": "tor" }]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
